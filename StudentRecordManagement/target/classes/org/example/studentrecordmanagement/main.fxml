<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://fxml.com/fxml/1" fx:controller="org.example.studentrecordmanagement.Controller">
    <children>
        <Label layoutX="30.0" layoutY="30.0" text="Student Registration">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <Label layoutX="30.0" layoutY="85.0" text="Name:" />
        <TextField fx:id="txtName" layoutX="110.0" layoutY="80.0" prefWidth="180.0" />

        <Label layoutX="30.0" layoutY="135.0" text="Course:" />
        <TextField fx:id="txtCourse" layoutX="110.0" layoutY="130.0" prefWidth="180.0" />

        <Label layoutX="30.0" layoutY="185.0" text="Year Level:" />
        <ChoiceBox fx:id="cbYear" layoutX="110.0" layoutY="180.0" prefWidth="180.0" />

        <Button layoutX="30.0" layoutY="250.0" mnemonicParsing="false" onAction="#addStudent" prefWidth="75.0" text="Add" />
        <Button layoutX="120.0" layoutY="250.0" mnemonicParsing="false" onAction="#updateStudent" prefWidth="75.0" text="Update" />
        <Button layoutX="210.0" layoutY="250.0" mnemonicParsing="false" onAction="#deleteStudent" prefWidth="75.0" text="Delete" />
        <Button layoutX="30.0" layoutY="300.0" mnemonicParsing="false" onAction="#clearFields" prefWidth="255.0" text="Clear" />

        <TableView fx:id="table" layoutX="320.0" layoutY="80.0" prefHeight="320.0" prefWidth="400.0">
            <columns>
                <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="colName" prefWidth="140.0" text="Name" />
                <TableColumn fx:id="colCourse" prefWidth="110.0" text="Course" />
                <TableColumn fx:id="colYear" prefWidth="98.0" text="Year Level" />
            </columns>
        </TableView>
    </children>
</AnchorPane>